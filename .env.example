# Hidden Café - Frontend Public Environment Variables
# ONLY public/anonymous keys go here. NEVER put service_role or database passwords in client files!

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (safe for browser use; protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-placeholder

# Optional: Supabase Edge Function Base URL (if custom domain or proxied)
# VITE_EDGE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1
